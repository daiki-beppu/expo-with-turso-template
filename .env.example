# Turso Database Configuration (Optional)
# ローカル開発時は不要です。Turso との同期が必要な場合のみ設定してください。

# Turso データベース URL
# 取得方法: turso db show <database-name> --url
EXPO_TURSO_DB_URL=libsql://your-database-url.turso.io

# Turso 認証トークン
# 取得方法: turso db tokens create <database-name>
EXPO_TURSO_DB_AUTH_TOKEN=your-auth-token-here
